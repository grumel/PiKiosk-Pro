# PiKiosk Pro - Watchdog-Dienst.
# Ueberwacht Browser, Netzwerk und System im 5-Sekunden-Takt.
# Die Platzhalter __KIOSK_USER__ und __INSTALL_DIR__ werden von
# install.sh beim Installieren ersetzt.

[Unit]
Description=PiKiosk Pro Watchdog
After=network-online.target pikiosk.service
Wants=network-online.target

[Service]
Type=simple
User=__KIOSK_USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/.venv/bin/python -m app.watchdog
Restart=always
RestartSec=5

# Haertung: Watchdog braucht weder Sonderrechte noch X11.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=__INSTALL_DIR__
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
