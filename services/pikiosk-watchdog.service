# PiKiosk Pro - Watchdog-Dienst.
# Ueberwacht Browser, Netzwerk und System im 5-Sekunden-Takt.
# Die Platzhalter __KIOSK_USER__ und __INSTALL_DIR__ werden von
# install.sh beim Installieren ersetzt.

[Unit]
Description=PiKiosk Pro Watchdog
After=network-online.target pikiosk.service
Wants=network-online.target
# Der Watchdog muss immer laufen: kein Neustartlimit, damit
# systemd ihn nach mehreren schnellen Fehlversuchen (etwa bei einer
# beim Booten voruebergehend vollen Platte) nicht dauerhaft aufgibt.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__KIOSK_USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/.venv/bin/python -m app.watchdog
Restart=always
RestartSec=5

# Haertung: Watchdog braucht kein X11 und keine Schreibrechte
# ausserhalb des Installationsverzeichnisses. Bewusst OHNE
# NoNewPrivileges und RestrictSUIDSGID: die Gateway-Pruefung ruft
# das ping-Binary auf, das setuid bzw. cap_net_raw benoetigt.
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=__INSTALL_DIR__
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
